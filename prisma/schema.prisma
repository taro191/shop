// Prisma schema for the grocery-store SaaS.
// Multi-tenant: every business table carries a storeId and is always
// queried/written scoped to the signed-in user's store.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum BillStatus {
  ORDERED // purchase order placed, not yet received — stock not affected yet
  PENDING // received (stock already added), payment owed
  PAID
  OVERDUE
}

enum LoyaltyEntryType {
  EARN
  REDEEM
}

model Store {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("trial")
  /// Thai PromptPay proxy: 10-digit mobile (0XXXXXXXXX) or 13-digit national/tax ID. Null = QR payment not set up yet.
  promptPayId String?
  createdAt   DateTime @default(now())

  users            User[]
  products         Product[]
  suppliers        Supplier[]
  bills            PurchaseBill[]
  transactions     IncomeTransaction[]
  customers        Customer[]
  stockAdjustments StockAdjustment[]
}

model User {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  phone        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Product {
  id                  String    @id @default(cuid())
  storeId             String
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  category            String
  unit                String
  barcode             String?
  costPrice           Float
  sellPrice           Float
  quantity            Int       @default(0)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  /// Optional best-before/expiry date for the current stock on hand.
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  supplierPrices    SupplierPrice[]
  billLineItems     BillLineItem[]
  saleLineItems     SaleLineItem[]
  stockAdjustments  StockAdjustment[]

  @@unique([storeId, barcode])
  @@index([storeId])
  @@index([storeId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  createdAt DateTime @default(now())

  prices              SupplierPrice[]
  bills               PurchaseBill[]
  preferredByProducts Product[]       @relation("PreferredSupplier")

  @@index([storeId])
}

model SupplierPrice {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  price      Float
  updatedAt  DateTime @updatedAt

  @@unique([productId, supplierId])
  @@index([productId])
}

model IncomeTransaction {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          String
  method         PaymentMethod
  amount         Float
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pointsEarned   Int           @default(0)
  pointsRedeemed Int           @default(0)
  discountAmount Float         @default(0)
  soldAt         DateTime      @default(now())

  lineItems SaleLineItem[]

  @@index([storeId, soldAt])
  @@index([customerId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  points    Int      @default(0)
  createdAt DateTime @default(now())

  transactions   IncomeTransaction[]
  loyaltyEntries LoyaltyEntry[]

  @@unique([storeId, phone])
  @@index([storeId])
}

/** Audit trail for point balance changes — lets a store explain "why does this
 * customer have 340 points" rather than trusting the running total blindly. */
model LoyaltyEntry {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       LoyaltyEntryType
  points     Int
  note       String?
  createdAt  DateTime         @default(now())

  @@index([customerId])
}

/** A stock-take correction: system count vs. physically counted, with a reason.
 * Separate from ordinary sale/receiving movements so shrinkage is visible on its own. */
model StockAdjustment {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  before    Int
  after     Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([productId])
}

/** One product line within a checked-out sale. Populated by the POS checkout
 * flow (src/app/(protected)/sell); older/manual "quick sale" transactions
 * have none, so reports blend real cost here with an estimate for those. */
model SaleLineItem {
  id            String            @id @default(cuid())
  transactionId String
  transaction   IncomeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Float
  unitCost      Float
  subtotal      Float

  @@index([transactionId])
  @@index([productId])
}

model PurchaseBill {
  id         String     @id @default(cuid())
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  billNo     String
  supplierId String
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  amount     Float
  status     BillStatus @default(PENDING)
  billDate   DateTime   @default(now())
  /// Set when an ORDERED bill's stock has been received (moved to PENDING). Null for
  /// bills logged directly as already-received (legacy) or still ORDERED.
  receivedAt DateTime?
  createdAt  DateTime   @default(now())

  lineItems BillLineItem[]

  @@index([storeId, billDate])
}

model BillLineItem {
  id        String       @id @default(cuid())
  billId    String
  bill      PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  qtyLabel  String
  /// Numeric quantity + unit, used to increment stock on receiving. Null on legacy
  /// free-text-only rows (created before this field existed) — those must be
  /// received manually since qtyLabel alone can't be parsed reliably back to a number.
  quantity  Int?
  unit      String?
  unitPrice Float
  subtotal  Float

  @@index([billId])
}
